  "cards": [
    {
      "dot": "cyan",
      "title": "Three HTTP surfaces, one Runner",
      "items": [
        "ADK /run, A2A JSON-RPC at /a2a/{app}, Agent Engine at /api/reasoning_engine",
        "All three share app.state.runner from FastAPI lifespan"
      ]
    },
    {
      "dot": "emerald",
      "title": "Shared session and artifacts",
      "items": [
        "shared://session and shared://artifact are process-wide",
        "Vertex sessions when GOOGLE_CLOUD_AGENT_ENGINE_ID is set; GCS artifacts when LOGS_BUCKET_NAME is set"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust and identity",
      "items": [
        "Gemini via Vertex ADC or GEMINI_API_KEY; GOOGLE_CLOUD_LOCATION is global",
        "get_weather and get_current_time are in-process stubs, not public internet calls"
      ]
    }
  ]
