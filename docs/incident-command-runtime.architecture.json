    {
      "dot": "cyan",
      "title": "Primary write path",
      "items": [
        "Stages: group → severity → actions → drafts → TTY → always-regroup → redecision",
        "Pair name is the session id; artifacts live under pipeline_files/<pair>/",
        "Resume reuses first-pass JSON and prints STORED; --rerun forces a fresh Vertex pass"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Vertex is outside the workspace; model JSON is not executed",
        "Guardrails canonicalize and forbid runbook/semantic-unsafe actions before accept",
        "validate_pair must succeed before VALIDATION_COMPLETE is stamped"
      ]
    },
    {
      "dot": "emerald",
      "title": "Assistant and eval",
      "items": [
        "FastAPI :8000 (agents-cli playground) serves root_agent plus A2A and reasoning_engine routes",
        "root_agent calls only summarize_pair; answers stay grounded in pair artifacts",
        "CI: agents-cli eval run with pipeline_artifact_checks; --fake-llm skips Vertex"
